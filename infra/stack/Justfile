set export := true
set dotenv-filename := ".env.local"
set dotenv-load

ALCHEMY_PROFILE := "personal"
ALCHEMY_NO_TUI := "1"
ALCHEMY_PLAIN := "1"

bun := require("bun")
bunx := require("bunx")

plan *args:
    {{ bunx }} alchemy plan --log-level all {{ args }}

deploy *args:
    {{ bunx }} alchemy deploy --yes --log-level all {{ args }}

destroy *args:
    {{ bunx }} alchemy destroy --yes --log-level all {{ args }}

# Print users, groups, peers, routes, nameservers and policy rules from the live account.
verify *args:
    {{ bun }} scripts/verify-access.ts {{ args }}

# Deploy home-infra with NetBird's dashboard Default policy disabled (default deny).
cutover *args:
    NETBIRD_DISABLE_DEFAULT_POLICY=1 {{ bunx }} alchemy deploy --yes --log-level all stack/home-infra.ts {{ args }}

# Undo cutover: deploy home-infra with the Default policy enabled again.
rollback *args:
    NETBIRD_DISABLE_DEFAULT_POLICY=0 {{ bunx }} alchemy deploy --yes --log-level all stack/home-infra.ts {{ args }}

bootstrap:
    {{ bunx }} alchemy cloudflare bootstrap

configure:
    {{ bunx }} alchemy login --configure
