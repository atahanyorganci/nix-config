{
	"name": "@yorganci/netbird-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./spec": "./spec/netbird.api.json",
		"./Credentials": "./src/credentials.ts",
		"./Errors": "./src/errors.ts",
		"./Protocol": "./src/protocol.ts",
		"./Retry": "./src/retry.ts",
		"./Traits": "./src/traits.ts",
		"./Services": "./src/services/index.ts",
		"./*": "./src/services/*.ts"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"convert": "node scripts/convert.ts",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"generate": "node scripts/convert.ts && node scripts/generate.ts && pnpm run lint:fix && pnpm run format:fix",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"spec:download": "node scripts/download.ts"
	},
	"dependencies": {
		"@distilled.cloud/core": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/language-service": "catalog:",
		"@effect/platform-node": "catalog:",
		"@yorganci/config": "workspace:*",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"yaml": "^2.9.0"
	},
	"spec": {
		"ref": "v0.80.0",
		"path": "shared/management/http/api/openapi.yml",
		"sha256": "011f51023d678c2819edcb087c59915c166bd60e7f3cceba5ae2569dc2c2a9d7"
	}
}
