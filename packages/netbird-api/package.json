{
	"name": "@yorganci/netbird-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./spec": "./spec/netbird.api.json",
		"./Credentials": "./src/credentials.ts",
		"./Errors": "./src/errors.ts",
		"./Protocol": "./src/protocol.ts",
		"./Retry": "./src/retry.ts",
		"./Traits": "./src/traits.ts",
		"./Services": "./src/services/index.ts",
		"./*": "./src/services/*.ts"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"convert": "bun scripts/convert.ts",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"generate": "bun scripts/convert.ts && bun scripts/generate.ts && bun run lint:fix && bun run format:fix",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"spec:download": "bun scripts/download.ts"
	},
	"dependencies": {
		"@distilled.cloud/core": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/language-service": "catalog:",
		"@effect/platform-bun": "catalog:",
		"@yorganci/config": "workspace:*",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"yaml": "^2.9.0"
	},
	"spec": {
		"ref": "v0.75.0",
		"path": "shared/management/http/api/openapi.yml",
		"sha256": "ec2f046e2722c505b4e779ff45ffd77bd224e4042756e1b7907378cfb64b0418"
	}
}
