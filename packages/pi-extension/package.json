{
	"name": "@yorganci/pi-extension",
	"version": "0.0.0",
	"private": true,
	"keywords": [
		"pi-package"
	],
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./fetch-content": "./src/fetch-content/index.ts",
		"./package.json": "./package.json",
		"./model-profile": "./src/model-profile/index.ts",
		"./usage": "./src/usage/index.ts",
		"./web-search": "./src/web-search/index.ts"
	},
	"scripts": {
		"build": "rolldown -c rolldown.config.ts",
		"check": "tsc --noEmit",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"test": "vitest --run"
	},
	"dependencies": {
		"@imput/cobalt-api": "catalog:",
		"defuddle": "catalog:",
		"linkedom": "catalog:",
		"unpdf": "catalog:"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@earendil-works/pi-tui": "catalog:",
		"@yorganci/config": "workspace:*",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"rolldown": "catalog:",
		"typebox": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./dist/fetch-content",
			"./dist/model-profile",
			"./dist/usage",
			"./dist/web-search"
		]
	}
}
