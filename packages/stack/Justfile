set export := true
set dotenv-filename := ".env.local"
set dotenv-load

ALCHEMY_PROFILE := "personal"
ALCHEMY_NO_TUI := "1"
ALCHEMY_PLAIN := "1"

AWS_REGION := "us-east-2"

node := require("node")
pnpm := require("pnpm")

plan *args:
    {{ pnpm }} exec alchemy plan --log-level all {{ args }}

deploy *args:
    {{ pnpm }} exec alchemy deploy --yes --log-level all {{ args }}

destroy *args:
    {{ pnpm }} exec alchemy destroy --yes --log-level all {{ args }}

# Print users, groups, peers, routes, nameservers and policy rules from the live account.
verify *args:
    {{ node }} scripts/verify-access.ts {{ args }}

test *args:
    {{ node }} scripts/test-netbird-network.ts {{ args }}

bootstrap:
    {{ pnpm }} exec alchemy cloudflare bootstrap

configure:
    {{ pnpm }} exec alchemy login --configure
