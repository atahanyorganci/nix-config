+static void dns_register_reply(DNSServiceRef sd_ref,
+			       DNSServiceFlags flags,
+			       DNSServiceErrorType err,
+			       const char *name,
+			       const char *regtype,
+			       const char *domain,
+			       void *context)
+{
+	if (err == kDNSServiceErr_NameConflict) {
+		DBG_WARNING("mDNS name \"%s\" is taken for %s; not "
+			    "advertising it\n", name, regtype);
+		return;
+	}
+	if (err != kDNSServiceErr_NoError) {
+		DBG_WARNING("mDNS registration of %s failed (err %d)\n",
+			    regtype, err);
+		return;
+	}
+
+	DBG_NOTICE("registered mDNS service \"%s\" %s%s\n",
+		   name, regtype, domain);
+}
+
+static DNSServiceErrorType dns_register_service(struct dns_reg_state *dns_state,
+						const char *name,
+						const char *regtype,
+						uint16_t port,
+						TXTRecordRef *txt)
+{
+	/* Sharing the connection: the child ref starts as a copy of it. */
+	DNSServiceRef ref = dns_state->conn_ref;
+
+	return DNSServiceRegister(&ref,
+				  kDNSServiceFlagsShareConnection |
+				  kDNSServiceFlagsNoAutoRename,
+				  kDNSServiceInterfaceIndexAny,
+				  name,
+				  regtype,
+				  NULL /* domain */,
+				  NULL /* SRV target host name */,
+				  htons(port),
+				  txt != NULL ? TXTRecordGetLength(txt) : 0,
+				  txt != NULL ? TXTRecordGetBytesPtr(txt) : NULL,
+				  dns_register_reply,
+				  dns_state);
+}
+
+static DNSServiceErrorType dns_register_device_info(struct dns_reg_state *dns_state,
+						    const char *name)
+{
+	const char *model = lp_parm_const_string(-1, "fruit", "model",
+						 "MacSamba");
+	TXTRecordRef txt;
+	DNSServiceErrorType err;
+
+	TXTRecordCreate(&txt, 0, NULL);
+	err = TXTRecordSetValue(&txt, "model", strlen(model), model);
+	if (err == kDNSServiceErr_NoError) {
+		err = dns_register_service(dns_state, name,
+					   "_device-info._tcp",
+					   DNS_REG_PLACEHOLDER_PORT, &txt);
+	}
+	TXTRecordDeallocate(&txt);
+
+	return err;
+}
+
+static DNSServiceErrorType dns_register_adisk(struct dns_reg_state *dns_state,
+					      const char *name)
+{
+	int num_services = lp_numservices();
+	TXTRecordRef txt;
+	DNSServiceErrorType err = kDNSServiceErr_NoError;
+	size_t dk = 0;
+	int snum;
+
+	TXTRecordCreate(&txt, 0, NULL);
+
+	for (snum = 0; snum < num_services; snum++) {
+		char key[32];
+		char *value = NULL;
+
+		if (!lp_snum_ok(snum) ||
+		    !lp_parm_bool(snum, "fruit", "time machine", false)) {
+			continue;
+		}
+
+		snprintf(key, sizeof(key), "dk%zu", dk++);
+		value = talloc_asprintf(dns_state, "adVN=%s,adVF=0x82",
+					lp_const_servicename(snum));
+		if (value == NULL) {
+			err = kDNSServiceErr_NoMemory;
+			goto done;
+		}
+		err = TXTRecordSetValue(&txt, key, strlen(value), value);
+		TALLOC_FREE(value);
+		if (err != kDNSServiceErr_NoError) {
+			goto done;
+		}
+	}
+
+	if (dk == 0) {
+		/* No Time Machine shares, nothing to advertise. */
+		goto done;
+	}
+
+	err = TXTRecordSetValue(&txt, "sys", strlen("adVF=0x100"),
+				"adVF=0x100");
+	if (err != kDNSServiceErr_NoError) {
+		goto done;
+	}
+
+	err = dns_register_service(dns_state, name, "_adisk._tcp",
+				   DNS_REG_PLACEHOLDER_PORT, &txt);
+	if (err == kDNSServiceErr_NoError) {
+		DBG_NOTICE("advertising %zu Time Machine share(s)\n", dk);
+	}
+
+done:
+	TXTRecordDeallocate(&txt);
+	return err;
+}
