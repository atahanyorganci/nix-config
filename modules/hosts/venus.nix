{
  config,
  inputs,
  ...
}: let
  user = config.flake.me;
  # NFS shares on the NAS, mounted on first access with the GUI session's
  # ticket. NFSv3, not 4.1: under Immich's concurrent jobs macOS's NFSv4.1
  # client deadlocked twice waiting for a session slot (`nfs41_sequence_set`)
  # after a run of OLD_STATEID and EACCES errors, hanging every process on
  # the share until a reboot; v3 keeps no session or open state to lose.
  # The server principal must be host-based (`nfs@host`): gssd reads
  # `nfs/host@REALM` as service `nfs/host` at host `REALM`. `resvport`
  # because the exports refuse unprivileged ports; `nfc` for non-ASCII names.
  # 256 KiB transfers, the most DSM accepts (it clamps larger requests):
  # against macOS's default 32 KiB, sequential writes went from 62 to 115
  # MB/s (the gigabit link) and eight parallel 3 MB writes from 44 to 69 MB/s.
  nasOptions = [
    "vers=3"
    "rsize=262144"
    "wsize=262144"
    "sec=krb5"
    "principal=immich@YORGANCI.DEV"
    "sprincipal=nfs@nas.yorganci.dev"
    "resvport"
    "hard"
    "intr"
    "nfc"
  ];
  venusHomeConfiguration = {user, ...}: {
    agents.enable = true;
    # Public keys + gpg CLI; no local agent (use forwarded YubiKey from sol).
    gpg.enable = true;
    gpg.agent.enable = false;
    ffmpeg.enable = true;
    git = {
      enable = true;
      aliases.enable = true;
      user = {
        inherit (user) name email key;
      };
    };
    gum.enable = true;
    node.enable = true;
    python.enable = true;
    # Reached from sol with `rex -S ssh://venus`.
    rex.server.enable = true;
    shell = {
      bash.enable = true;
      fish.enable = true;
      zsh.enable = true;
    };
    tools.enable = true;
    uutils.enable = true;
    wget.enable = true;
    zed.enable = true;
  };
  venusDarwinModule = {
    config,
    pkgs,
    user,
    inputs,
    ...
  }: {
    hostInventory.role = "managedTarget";
    hostInventory.netbird.group = "Server";
    hostInventory.ssh.localHostName.enable = true;
    # Generated by nix-config, not macOS, and backed up in nix-secrets
    # (`identities/venus/ssh_host_ed25519_key`, admins only). After reinstalling
    # macOS, restore it (nix-secrets README, "Restore an identity by hand")
    # rather than pinning a new one.
    hostInventory.ssh.hostKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGDpJEGwfqm6Lsdj8Kpd8yKXU3Vd9sx7HAxpceVm4FFY";
    # Hostname
    networking.hostName = "venus";
    # Disable `nix-darwin` documentation
    documentation.enable = false;
    # Work around nix-darwin manual generation failing with newer nixos-render-docs.
    # The uninstaller builds its own default Darwin system, which still enables docs.
    system.tools.darwin-uninstaller.enable = false;
    # Enable entering sudo mode with Touch ID.
    security.pam.services.sudo_local.touchIdAuth = true;
    security.sudo.extraConfig = ''
      ${user.username} ALL=(ALL) NOPASSWD: ALL
    '';
    # Set Git commit hash for darwin-version.
    system.configurationRevision = inputs.self.rev or inputs.self.dirtyRev or null;
    # Ensures compatibility with defaults from NixOS
    system.stateVersion = 4;
    # User used for options that previously applied to the user running `darwin-rebuild`
    system.primaryUser = user.username;
    # Users managed by Nix
    users.knownUsers = [user.username];
    users.users.${user.username} = {
      name = user.username;
      description = user.name;
      home = "/Users/${user.username}";
      shell = pkgs.${user.shell};
      # User ID created by MacOS for the user use `id -u` to get it.
      uid = 501;
    };
    # Orbstack OCI runtime
    orbstack.enable = true;
    # Arr Stack
    arr-stack = {
      enable = true;
      domain = "yorganci.dev";
    };
    # Calibre
    calibre-web = {
      enable = true;
      listen.ip = "0.0.0.0";
      options = {
        enableBookUploading = true;
        # Logged in as the NetBird user the reverse proxy vouches for: its
        # email is the Calibre-Web username. Only the proxy reaches the port
        # over the mesh, and the header from any other address is dropped.
        reverseProxyAuth = {
          enable = true;
          header = "X-NetBird-User";
          trustedProxies = ["100.64.0.0/10"];
        };
      };
    };
    # SMB over the mesh, for Admin devices away from home; on the LAN it needs
    # no rule.
    meshServices.smb = {
      port = 445;
      groups = ["Admin"];
    };
    # Screen Sharing (VNC) over the mesh, for Admin devices: `vnc://venus`.
    meshServices.screenSharing = {
      port = 5900;
      groups = ["Admin"];
    };
    # SMB file sharing (replaces Apple's File Sharing)
    samba = {
      enable = true;
      # Loopback, the LAN and the NetBird mesh (CGNAT range).
      hostsAllow = ["127.0.0.1" "192.168.1.0/24" "100.64.0.0/10"];
      bonjour.model = "Macmini9,1";
      users.${user.username}.passwordFile = config.sops.secrets."samba/${user.username}".path;
      shares = let
        # Only atahan may connect, read or write.
        private = {
          validUsers = [user.username];
          writeList = [user.username];
        };
      in {
        Media =
          private
          // {
            path = "/Volumes/Atahan/Videos";
            comment = "Movies and TV shows";
          };
        Documents =
          private
          // {
            path = "/Volumes/Atahan/Documents";
            comment = "Documents on the external drive";
          };
        Downloads =
          private
          // {
            path = "${config.users.users.${user.username}.home}/Downloads";
            comment = "Downloads, including Transmission's";
          };
      };
    };
    # From `hosts/venus.yaml` in the secrets repository.
    sops.secrets."samba/${user.username}" = {};
    # Loopback KDC minting venus's own tickets for the NAS's Kerberos NFS
    # exports (`sec=krb5`). The NAS checks them with the keytab of
    # nfs/nas.yorganci.dev, exported once with `sudo krb5-local-kadmin -q
    # "ktadd -norandkey -k <file> nfs/nas.yorganci.dev"` and imported in DSM
    # (File Services > NFS > Kerberos Settings), with immich@YORGANCI.DEV
    # mapped to the DSM user immich.
    kerberos = {
      enable = true;
      masterPasswordFile = config.sops.secrets."kerberos/master".path;
      principals = {
        "nfs/nas.yorganci.dev".passwordFile = config.sops.secrets."kerberos/nfs-nas".path;
        immich = {
          passwordFile = config.sops.secrets."kerberos/immich".path;
          keytab.owner = user.username;
        };
      };
      # The GUI session's: it triggers the automounted share (tickets are per
      # login session) and runs Immich.
      tickets.immich = {
        principal = "immich";
        user = user.username;
      };
    };
    sops.secrets = {
      "kerberos/master" = {};
      "kerberos/nfs-nas" = {};
      "kerberos/immich" = {};
    };
    # NFSv4 owners map through this domain; DSM's NFSv4 domain matches.
    nfsClient = {
      enable = true;
      nfs4Domain = "yorganci.dev";
      # Immich's library: originals, thumbnails, database dumps.
      automounts.immich = {
        mountPoint = "/System/Volumes/Data/nas/immich";
        source = "nas.local:/volume1/Immich";
        options = nasOptions;
      };
      # The family photo archive, read in place by Immich external
      # libraries; read-only, so nothing on this side can change it.
      automounts.media = {
        mountPoint = "/System/Volumes/Data/nas/media";
        source = "nas.local:/volume1/Media";
        options = ["ro"] ++ nasOptions;
      };
    };
    # Holds the Network Volumes grant for Immich's server.
    tccLauncher.enable = true;
    # Photos on the NAS share; database, queue and models on local disk.
    services.immich = {
      enable = true;
      mediaLocation = config.nfsClient.automounts.immich.mountPoint;
      # Authelia only: password sign-in is off, Admin members are admins.
      oidc = {
        enable = true;
        publicUrl = "https://photos.yorganci.dev";
        groups = ["Admin" "User"];
      };
      settings = {
        # Originals under library/<storage label>/<year>/<date>/ rather than
        # upload/<user id>/ with random names.
        storageTemplate = {
          enabled = true;
          template = "{{y}}/{{y}}-{{MM}}-{{dd}}/{{filename}}";
        };
        # Phones record HEVC; play it as recorded instead of transcoding it
        # to H.264 on the CPU (Immich has no VideoToolbox encoder). Browsers
        # without HEVC, such as Firefox on Linux, cannot play those videos.
        ffmpeg.acceptedVideoCodecs = ["h264" "hevc"];
        # Smart search in English and Turkish: Pareto-optimal for both in
        # Immich's model benchmarks, at about 2.8 GiB while loaded.
        machineLearning.clip.modelName = "ViT-L-16-SigLIP2-256__webli";
        job.thumbnailGeneration.concurrency = 4;
      };
    };
    # Public through the NetBird proxy, like Jellyfin's `watch`; Immich signs
    # people in itself, so the apps and API keys keep working.
    httpServices.photos = {
      port = config.services.immich.port;
      expose = {
        enable = true;
        private = false;
        accessGroups = ["Admin" "User"];
      };
      auth.type = "none";
    };
    # rclone remotes; credentials from `rclone/*` in `hosts/venus.yaml`.
    rclone.enable = true;
    # SSH
    ssh.enable = true;
    # Self-hosted NetBird mesh
    netbird = {
      enable = true;
      setupKeyFile = "/var/lib/netbird-client/setup.key";
    };
  };
in {
  flake = {
    darwinConfigurations.venus = inputs.nix-darwin.lib.darwinSystem {
      system = "aarch64-darwin";
      modules = [
        venusDarwinModule
        {
          home-manager.useGlobalPkgs = true;
          home-manager.useUserPackages = true;
          home-manager.verbose = true;
          home-manager.users.${user.username} = {...}: {
            imports = [
              config.flake.modules.homeManager.default
              venusHomeConfiguration
            ];
          };
          home-manager.extraSpecialArgs = {
            inherit user inputs;
          };
        }
        config.flake.modules.darwin.default
      ];
      specialArgs = {
        inherit inputs user;
      };
    };
  };
}
