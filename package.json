{
	"name": "@yorganci/nix-config",
	"private": true,
	"workspaces": [
		"infra/*"
	],
	"type": "module",
	"scripts": {
		"check": "turbo run check",
		"format": "turbo run format",
		"format:fix": "turbo run format:fix",
		"format:root": "oxfmt --check --disable-nested-config .",
		"format:root:fix": "oxfmt --write --disable-nested-config .",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"test": "turbo run test"
	},
	"devDependencies": {
		"@yorganci/config": "workspace:*",
		"oxfmt": "catalog:",
		"turbo": "catalog:"
	},
	"packageManager": "bun@1.3.13",
	"catalog": {
		"@distilled.cloud/core": "0.30.3",
		"@effect/language-service": "0.77.0",
		"@effect/platform-bun": "4.0.0-beta.101",
		"@effect/platform-node": "4.0.0-beta.101",
		"@effect/platform-node-shared": "4.0.0-beta.101",
		"@effect/vitest": "4.0.0-beta.101",
		"alchemy": "2.0.0-beta.66",
		"effect": "4.0.0-beta.101",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"oxlint-tsgolint": "^0.23.0",
		"turbo": "^2.10.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.8"
	}
}
